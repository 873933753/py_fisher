# ============================================================
#  环境变量模板（提交 Git）
# ------------------------------------------------------------
# 用法：
#   1) 复制本文件为 .env.dev（本地完整配置，勿提交）
#   2) 新建 .env，只写：APP_ENV=dev
#   3) 把下面占位符改成真实值后重启进程
#
# 加载顺序（app/secure.py）：
#   .env → .env.{APP_ENV}
#   进程里已有的环境变量优先（Docker / CI / 测试）
#
# 生产：优先用平台/容器注入同名变量；不必依赖服务器上的 .env.prod 文件
# ============================================================

# ---------- 开关（通常只写在 .env 里）----------
# 取值：dev / staging / prod
APP_ENV=dev

# ---------- 必填：数据库 ----------
# 需先建库：CREATE DATABASE fisher CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fisher?charset=utf8mb4

# ---------- 必填：JWT ----------
# JWT_SECRET_KEY 请用足够长的随机串（不要用示例值上生产）
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
# 分钟；必须是整数（不要写 60*24）
JWT_EXPIRE_MINUTES=1440

# ---------- 必填：Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 必填：邮箱（发重置密码等）----------
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
# 以下目前在代码里写死默认值；若你后续改成可读 env，再取消注释并写进 secure.py
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_SENDER=Hanber <your_email@example.com>

# ---------- 必填：图书/ISBN 查询（环境变量名必须是 AppKey）----------
# 代码中：secure.ISBN_KEY = AppKey；secure.YU_SHU_API_BASE = YU_SHU_API_BASE
AppKey=your_app_key_here
# 第三方接口根地址，末尾不要带 /（真实地址写在 .env.dev，勿提交）
YU_SHU_API_BASE=https://your-api-host/api

# ---------- 可选 ----------
# SQL 日志：dev 可 true；prod 建议 false
SQL_ECHO=false