# 复制为 docker/.env.docker 并填入真实值（.env.docker 勿提交 Git）
APP_ENV=prod
SQL_ECHO=false

# MySQL 初始化（db 容器）
# MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 必须与 DATABASE_URL 一致
MYSQL_ROOT_PASSWORD=replace_root_password
MYSQL_DATABASE=DATABASE_NAME
MYSQL_USER=USER_NAME
MYSQL_PASSWORD=replace_db_user_password
REDIS_PASSWORD=replace_redis_password

# App 连接（主机名用 compose 服务名 db / redis）
DATABASE_URL=mysql+pymysql://USER_NAME:replace_db_user_password@db:3306/DATABASE_NAME?charset=utf8mb4
REDIS_URL=redis://:replace_redis_password@redis:6379/0

JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password

AppKey=your_app_key_here
YU_SHU_API_BASE=https://your-api-host/api

# ---------- oss配置 ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-shanghai.aliyuncs.com

# ---------- 可选：CORS ----------
# 浏览器前端来源，逗号分隔；生产务必写死域名，不要用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173